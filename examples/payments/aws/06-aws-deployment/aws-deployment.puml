@startuml
' Architecture Suite schema 2.0; PlantUML computes its own layout
!include <C4/C4_Deployment>
LAYOUT_TOP_DOWN()
Deployment_Node(n0, "AWS Cloud", "cloud") {
  Deployment_Node(n1, "PayStream production account", "account") {
    Container(n2, "Merchant Dashboard", "React single-page app", "Payments, refunds, disputes and payouts for merchants")
    Deployment_Node(n3, "eu-west-1", "region") {
      Container(n4, "Fraud Scoring", "Python ML model", "Scores each payment for fraud risk before authorization")
      ContainerQueue(n5, "Payment Event Stream", "Event bus", "Ordered payment lifecycle events")
      ContainerDb(n6, "Settlement Archive", "Object storage", "Raw acquirer settlement files")
      Container(n7, "Settlement Worker", "Python batch jobs", "Reconciles acquirer settlement files and initiates payouts")
      ContainerDb(n8, "Vault Key Store", "Managed KMS", "Key-encryption keys for the card vault")
      Container(n9, "Webhook Dispatcher", "Node.js", "Signs and delivers payment events to merchants, with retries")
      Deployment_Node(n10, "payments-vpc", "vpc") {
        Deployment_Node(n11, "app-subnet", "subnet") {
          Container(n12, "Ledger Service", "Kotlin", "Double-entry ledger of balances, fees and payouts")
          Container(n13, "Payments API", "Go", "Public REST API for payment intents, captures and refunds")
          Deployment_Node(n14, "orchestrator-cluster", "cluster") {
            Container(n15, "Payment Orchestrator", "Java", "Drives each payment through authorization, capture and refund")
          }
        }
        Deployment_Node(n16, "cde-subnet (cardholder data)", "subnet") {
          Container(n17, "Card Vault", "Rust", "Tokenizes card numbers inside the cardholder data environment")
        }
        Deployment_Node(n18, "data-subnet", "subnet") {
          ContainerDb(n19, "Idempotency Cache", "Redis", "Short-lived idempotency keys and responses")
          ContainerDb(n20, "Ledger Store", "Distributed SQL", "Strongly consistent journal and balance records")
          ContainerDb(n21, "Payments Database", "PostgreSQL", "Payment intents, merchants and API keys")
          ContainerDb(n22, "Reporting Warehouse", "Columnar warehouse", "Reconciliation and finance analytics")
        }
      }
    }
  }
}
Deployment_Node(n23, "Shopper browser", "device") {
  Deployment_Node(n24, "Web browser", "execution-environment") {
    Container(n25, "Checkout Web SDK", "TypeScript in the shopper's browser", "Hosted payment fields embedded in merchant checkout pages")
  }
}
Rel(n15, n4, "Requests a fraud score [gRPC]")
Rel(n15, n17, "Detokenizes the card for the network request [mTLS]")
Rel(n17, n8, "Wraps and unwraps data keys [KMS API]")
Rel(n15, n5, "Publishes payment lifecycle events [events]")
Rel(n5, n12, "Delivers captured, refunded and fee events [events]")
Rel(n12, n20, "Posts double-entry journal entries [SQL]")
Rel(n12, n22, "Streams journal entries [batch export]")
Rel(n25, n17, "Submits card data for a token [HTTPS]")
Rel(n5, n9, "Delivers merchant-facing events [events]")
Rel(n7, n6, "Archives settlement files [object API]")
Rel(n7, n12, "Reconciles merchant balances [gRPC]")
Rel(n25, n13, "Confirms the payment with the card token [HTTPS]")
Rel(n2, n13, "Lists payments and issues refunds [HTTPS]")
Rel(n13, n21, "Looks up API keys; Persists payment intents [SQL]")
Rel(n13, n19, "Stores request keys and responses [Redis]")
Rel(n13, n15, "Starts authorization [gRPC]")
SHOW_LEGEND()
@enduml
