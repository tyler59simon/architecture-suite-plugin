@startuml
' Architecture Suite schema 2.0; PlantUML computes its own layout
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
System_Ext(n0, "Merchant Webhook Endpoint", "Merchant back-end that calls the API and receives events")
Container(n1, "Checkout Web SDK", "TypeScript in the shopper's browser", "Hosted payment fields embedded in merchant checkout pages")
Container(n2, "Merchant Dashboard", "React single-page app", "Payments, refunds, disputes and payouts for merchants")
Container(n3, "Payment Orchestrator", "Java", "Drives each payment through authorization, capture and refund")
ContainerDb(n4, "Payments Database", "PostgreSQL", "Payment intents, merchants and API keys")
ContainerDb(n5, "Idempotency Cache", "Redis", "Short-lived idempotency keys and responses")
Container_Boundary(n6, "Payments API") {
  Component(n7, "Merchant Authenticator", "Go", "Validates secret API keys and scopes")
  Component(n8, "Idempotency Guard", "Go", "Makes retried requests return the original result")
  Component(n9, "Payment Intents Controller", "Go", "Creates and confirms payment intents")
}
Rel(n1, n9, "Confirms the payment with the card token [HTTPS]")
Rel(n2, n9, "Lists payments and issues refunds [HTTPS]")
Rel(n0, n7, "Calls the API server-side with a secret key [HTTPS]")
Rel(n7, n4, "Looks up API keys [SQL]")
Rel(n9, n8, "Reserves the idempotency key [in-process]")
Rel(n8, n5, "Stores request keys and responses [Redis]")
Rel(n9, n4, "Persists payment intents [SQL]")
Rel(n9, n3, "Starts authorization [gRPC]")
SHOW_LEGEND()
@enduml
