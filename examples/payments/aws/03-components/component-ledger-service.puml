@startuml
' Architecture Suite schema 2.0; PlantUML computes its own layout
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
Container(n0, "Settlement Worker", "Python batch jobs", "Reconciles acquirer settlement files and initiates payouts")
ContainerDb(n1, "Ledger Store", "Distributed SQL", "Strongly consistent journal and balance records")
ContainerQueue(n2, "Payment Event Stream", "Event bus", "Ordered payment lifecycle events")
ContainerDb(n3, "Reporting Warehouse", "Columnar warehouse", "Reconciliation and finance analytics")
Container_Boundary(n4, "Ledger Service") {
  Component(n5, "Journal Writer", "Kotlin", "Posts balanced journal entries for money movements")
  Component(n6, "Balance Calculator", "Kotlin", "Computes available and pending merchant balances")
}
Rel(n2, n5, "Delivers captured, refunded and fee events [events]")
Rel(n5, n1, "Posts double-entry journal entries [SQL]")
Rel(n5, n3, "Streams journal entries [batch export]")
Rel(n0, n6, "Reconciles merchant balances [gRPC]")
SHOW_LEGEND()
@enduml
