@startuml
' Architecture Suite schema 2.0; PlantUML computes its own layout
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
System_Ext(n0, "3-D Secure Directory Server", "Card network cardholder authentication")
System_Ext(n1, "Acquirer Processor", "Card authorization, capture and settlement")
System_Ext(n2, "Bank Payout Rail", "Bank transfers for merchant payouts")
Person(n3, "Finance Operations", "Reconciles settlements and payouts")
Person(n4, "Merchant", "Accepts payments and receives payouts")
System_Ext(n5, "Merchant Webhook Endpoint", "Merchant back-end that calls the API and receives events")
Person(n6, "Risk Analyst", "Reviews flagged payments and fraud rules")
Person(n7, "Shopper", "Pays for orders at merchant checkouts")
System_Boundary(n8, "PayStream") {
  Container(n9, "Card Vault", "Rust", "Tokenizes card numbers inside the cardholder data environment\nDrill-down: 2 component, 2 code")
  Container(n10, "Checkout Web SDK", "TypeScript in the shopper's browser", "Hosted payment fields embedded in merchant checkout pages")
  Container(n11, "Fraud Scoring", "Python ML model", "Scores each payment for fraud risk before authorization\nDrill-down: 2 component, 2 code")
  ContainerDb(n12, "Idempotency Cache", "Redis", "Short-lived idempotency keys and responses")
  Container(n13, "Ledger Service", "Kotlin", "Double-entry ledger of balances, fees and payouts\nDrill-down: 2 component, 2 code")
  ContainerDb(n14, "Ledger Store", "Distributed SQL", "Strongly consistent journal and balance records")
  Container(n15, "Merchant Dashboard", "React single-page app", "Payments, refunds, disputes and payouts for merchants")
  ContainerQueue(n16, "Payment Event Stream", "Event bus", "Ordered payment lifecycle events")
  Container(n17, "Payment Orchestrator", "Java", "Drives each payment through authorization, capture and refund\nDrill-down: 3 component, 4 code")
  Container(n18, "Payments API", "Go", "Public REST API for payment intents, captures and refunds\nDrill-down: 3 component, 3 code")
  ContainerDb(n19, "Payments Database", "PostgreSQL", "Payment intents, merchants and API keys")
  ContainerDb(n20, "Reporting Warehouse", "Columnar warehouse", "Reconciliation and finance analytics")
  ContainerDb(n21, "Settlement Archive", "Object storage", "Raw acquirer settlement files")
  Container(n22, "Settlement Worker", "Python batch jobs", "Reconciles acquirer settlement files and initiates payouts")
  ContainerDb(n23, "Vault Key Store", "Managed KMS", "Key-encryption keys for the card vault")
  Container(n24, "Webhook Dispatcher", "Node.js", "Signs and delivers payment events to merchants, with retries")
}
Rel(n7, n10, "Enters card details at checkout [HTTPS]")
Rel(n17, n11, "Requests a fraud score [gRPC]")
Rel(n6, n11, "Reviews flagged payments and tunes rules [HTTPS]")
Rel(n17, n0, "Authenticates the cardholder [EMV 3DS over HTTPS]")
Rel(n17, n9, "Detokenizes the card for the network request [mTLS]")
Rel(n17, n1, "Authorizes, captures and refunds [ISO 8583 over TLS]")
Rel(n9, n23, "Wraps and unwraps data keys [KMS API]")
Rel(n17, n16, "Publishes payment lifecycle events [events]")
Rel(n16, n13, "Delivers captured, refunded and fee events [events]")
Rel(n13, n14, "Posts double-entry journal entries [SQL]")
Rel(n13, n20, "Streams journal entries [batch export]")
Rel(n10, n9, "Submits card data for a token [HTTPS]")
Rel(n16, n24, "Delivers merchant-facing events [events]")
Rel(n24, n5, "Delivers signed webhooks [HTTPS]")
Rel(n22, n1, "Downloads settlement files [SFTP]")
Rel(n22, n21, "Archives settlement files [object API]")
Rel(n22, n13, "Reconciles merchant balances [gRPC]")
Rel(n22, n2, "Initiates merchant payouts [ISO 20022]")
Rel(n3, n20, "Runs reconciliation and payout reports [SQL]")
Rel(n10, n18, "Confirms the payment with the card token [HTTPS]")
Rel(n4, n15, "Reviews payments, refunds and payouts [HTTPS]")
Rel(n15, n18, "Lists payments and issues refunds [HTTPS]")
Rel(n5, n18, "Calls the API server-side with a secret key [HTTPS]")
Rel(n18, n19, "Looks up API keys; Persists payment intents [SQL]")
Rel(n18, n12, "Stores request keys and responses [Redis]")
Rel(n18, n17, "Starts authorization [gRPC]")
SHOW_LEGEND()
@enduml
