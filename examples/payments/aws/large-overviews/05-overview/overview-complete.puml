@startuml
' Architecture Suite schema 2.0; PlantUML computes its own layout
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
System_Ext(n0, "3-D Secure Directory Server", "Card network cardholder authentication")
System_Ext(n1, "Acquirer Processor", "Card authorization, capture and settlement")
System_Ext(n2, "Bank Payout Rail", "Bank transfers for merchant payouts")
Person(n3, "Finance Operations", "Reconciles settlements and payouts")
Person(n4, "Merchant", "Accepts payments and receives payouts")
System_Ext(n5, "Merchant Webhook Endpoint", "Merchant back-end that calls the API and receives events")
Person(n6, "Risk Analyst", "Reviews flagged payments and fraud rules")
Person(n7, "Shopper", "Pays for orders at merchant checkouts")
System_Boundary(n8, "PayStream") {
  Container(n9, "Checkout Web SDK", "TypeScript in the shopper's browser", "Hosted payment fields embedded in merchant checkout pages")
  ContainerDb(n10, "Idempotency Cache", "Redis", "Short-lived idempotency keys and responses")
  ContainerDb(n11, "Ledger Store", "Distributed SQL", "Strongly consistent journal and balance records")
  Container(n12, "Merchant Dashboard", "React single-page app", "Payments, refunds, disputes and payouts for merchants")
  ContainerQueue(n13, "Payment Event Stream", "Event bus", "Ordered payment lifecycle events")
  ContainerDb(n14, "Payments Database", "PostgreSQL", "Payment intents, merchants and API keys")
  ContainerDb(n15, "Reporting Warehouse", "Columnar warehouse", "Reconciliation and finance analytics")
  ContainerDb(n16, "Settlement Archive", "Object storage", "Raw acquirer settlement files")
  Container(n17, "Settlement Worker", "Python batch jobs", "Reconciles acquirer settlement files and initiates payouts")
  ContainerDb(n18, "Vault Key Store", "Managed KMS", "Key-encryption keys for the card vault")
  Container(n19, "Webhook Dispatcher", "Node.js", "Signs and delivers payment events to merchants, with retries")
  Container_Boundary(n20, "Card Vault") {
    Boundary(n21, "Card Tokenizer", "component") {
      Component(n22, "CardTokenizer", "class", "Illustrative implementation\n+tokenize(pan, expiry): CardToken\n+detokenize(token): CardData")
    }
    Boundary(n23, "Envelope Encryptor", "component") {
      Component(n24, "EnvelopeEncryptor", "class", "Illustrative implementation\n+encrypt(plaintext, keyId): Ciphertext\n+decrypt(ciphertext): Bytes")
    }
  }
  Container_Boundary(n25, "Fraud Scoring") {
    Boundary(n26, "Risk Scorer", "component") {
      Component(n27, "RiskScorer", "class", "Illustrative implementation\n+score(payment): RiskScore")
    }
    Boundary(n28, "Rules Engine", "component") {
      Component(n29, "RuleSet", "class", "Illustrative implementation\n+evaluate(payment, score): Decision")
    }
  }
  Container_Boundary(n30, "Ledger Service") {
    Boundary(n31, "Balance Calculator", "component") {
      Component(n32, "BalanceCalculator", "class", "Illustrative implementation\n+balance(merchantId, currency): Balance")
    }
    Boundary(n33, "Journal Writer", "component") {
      Component(n34, "JournalWriter", "class", "Illustrative implementation\n+post(entries): JournalId")
    }
  }
  Container_Boundary(n35, "Payment Orchestrator") {
    Boundary(n36, "3DS Handler", "component") {
      Component(n37, "ThreeDSecureClient", "class", "Illustrative implementation\n+authenticate(payment): AuthenticationResult")
    }
    Boundary(n38, "Acquirer Router", "component") {
      Component(n39, "AcquirerRouter", "class", "Illustrative implementation\n+route(payment): AcquirerConnection")
    }
    Boundary(n40, "Payment State Machine", "component") {
      Component(n41, "PaymentState", "interface", "Illustrative implementation\n+next(event): PaymentState")
      Component(n42, "PaymentStateMachine", "class", "Illustrative implementation\n+authorize(payment): Authorization\n+capture(payment, amount): Capture\n+refund(payment, amount): Refund")
    }
  }
  Container_Boundary(n43, "Payments API") {
    Boundary(n44, "Idempotency Guard", "component") {
      Component(n45, "IdempotencyGuard", "class", "Illustrative implementation\n+reserve(key, requestHash): Reservation\n+complete(key, response)")
    }
    Boundary(n46, "Merchant Authenticator", "component") {
      Component(n47, "ApiKeyAuthenticator", "class", "Illustrative implementation\n+authenticate(apiKey): Merchant\n+requireScope(merchant, scope)")
    }
    Boundary(n48, "Payment Intents Controller", "component") {
      Component(n49, "PaymentIntentController", "class", "Illustrative implementation\n+create(request): PaymentIntent\n+confirm(id, cardToken): PaymentIntent\n+refund(id, amount): Refund")
    }
  }
}
Rel(n42, n41, "Delegates each transition to the current state [in-process]")
Rel(n9, n21, "Submits card data for a token [HTTPS]")
Rel(n35, n21, "Detokenizes the card for the network request [mTLS]")
Rel(n21, n23, "Encrypts card records [in-process]")
Rel(n23, n18, "Wraps and unwraps data keys [KMS API]")
Rel(n35, n26, "Requests a fraud score [gRPC]")
Rel(n26, n28, "Applies block and review rules [in-process]")
Rel(n6, n28, "Reviews flagged payments and tunes rules [HTTPS]")
Rel(n13, n33, "Delivers captured, refunded and fee events [events]")
Rel(n33, n11, "Posts double-entry journal entries [SQL]")
Rel(n33, n15, "Streams journal entries [batch export]")
Rel(n17, n31, "Reconciles merchant balances [gRPC]")
Rel(n43, n40, "Starts authorization [gRPC]")
Rel(n40, n36, "Requests cardholder authentication [in-process]")
Rel(n36, n0, "Authenticates the cardholder [EMV 3DS over HTTPS]")
Rel(n40, n38, "Sends authorization and capture [in-process]")
Rel(n38, n1, "Authorizes, captures and refunds [ISO 8583 over TLS]")
Rel(n40, n13, "Publishes payment lifecycle events [events]")
Rel(n9, n48, "Confirms the payment with the card token [HTTPS]")
Rel(n12, n48, "Lists payments and issues refunds [HTTPS]")
Rel(n5, n46, "Calls the API server-side with a secret key [HTTPS]")
Rel(n46, n14, "Looks up API keys [SQL]")
Rel(n48, n44, "Reserves the idempotency key [in-process]")
Rel(n44, n10, "Stores request keys and responses [Redis]")
Rel(n48, n14, "Persists payment intents [SQL]")
Rel(n7, n9, "Enters card details at checkout [HTTPS]")
Rel(n13, n19, "Delivers merchant-facing events [events]")
Rel(n19, n5, "Delivers signed webhooks [HTTPS]")
Rel(n17, n1, "Downloads settlement files [SFTP]")
Rel(n17, n16, "Archives settlement files [object API]")
Rel(n17, n2, "Initiates merchant payouts [ISO 20022]")
Rel(n3, n15, "Runs reconciliation and payout reports [SQL]")
Rel(n4, n12, "Reviews payments, refunds and payouts [HTTPS]")
SHOW_LEGEND()
@enduml
