  Container_Boundary(n75, "Payments API") {
    Component(n76, "Merchant Authenticator", "Go", "Validates secret API keys and scopes")
    Component(n77, "Idempotency Guard", "Go", "Makes retried requests return the original result")
    Component(n78, "Payment Intents Controller", "Go", "Creates and confirms payment intents")
  }
}
rectangle "3DS Handler — Code" as panel_7 {
  Boundary(n80, "3DS Handler", "component") {
    Component(n81, "ThreeDSecureClient", "class", "Illustrative implementation\n+authenticate(payment): AuthenticationResult")
  }
}
rectangle "Acquirer Router — Code" as panel_8 {
  Boundary(n83, "Acquirer Router", "component") {
    Component(n84, "AcquirerRouter", "class", "Illustrative implementation\n+route(payment): AcquirerConnection")
  }
}
rectangle "Balance Calculator — Code" as panel_9 {
  Boundary(n86, "Balance Calculator", "component") {
    Component(n87, "BalanceCalculator", "class", "Illustrative implementation\n+balance(merchantId, currency): Balance")
  }
}
rectangle "Card Tokenizer — Code" as panel_10 {
  Boundary(n89, "Card Tokenizer", "component") {
    Component(n90, "CardTokenizer", "class", "Illustrative implementation\n+tokenize(pan, expiry): CardToken\n+detokenize(token): CardData")
  }
}
rectangle "Envelope Encryptor — Code" as panel_11 {
  Boundary(n92, "Envelope Encryptor", "component") {
    Component(n93, "EnvelopeEncryptor", "class", "Illustrative implementation\n+encrypt(plaintext, keyId): Ciphertext\n+decrypt(ciphertext): Bytes")
  }
}
rectangle "Idempotency Guard — Code" as panel_12 {
  Boundary(n95, "Idempotency Guard", "component") {
    Component(n96, "IdempotencyGuard", "class", "Illustrative implementation\n+reserve(key, requestHash): Reservation\n+complete(key, response)")
  }
}
rectangle "Journal Writer — Code" as panel_13 {
  Boundary(n98, "Journal Writer", "component") {
    Component(n99, "JournalWriter", "class", "Illustrative implementation\n+post(entries): JournalId")
  }
}
rectangle "Merchant Authenticator — Code" as panel_14 {
  Boundary(n101, "Merchant Authenticator", "component") {
    Component(n102, "ApiKeyAuthenticator", "class", "Illustrative implementation\n+authenticate(apiKey): Merchant\n+requireScope(merchant, scope)")
  }
}
rectangle "Payment Intents Controller — Code" as panel_15 {
  Boundary(n104, "Payment Intents Controller", "component") {
    Component(n105, "PaymentIntentController", "class", "Illustrative implementation\n+create(request): PaymentIntent\n+confirm(id, cardToken): PaymentIntent\n+refund(id, amount): Refund")
  }
}
rectangle "Payment State Machine — Code" as panel_16 {
  Boundary(n107, "Payment State Machine", "component") {
    Component(n108, "PaymentStateMachine", "class", "Illustrative implementation\n+authorize(payment): Authorization\n+capture(payment, amount): Capture\n+refund(payment, amount): Refund")
    Component(n109, "PaymentState", "interface", "Illustrative implementation\n+next(event): PaymentState")
  }
}
rectangle "Risk Scorer — Code" as panel_17 {
  Boundary(n111, "Risk Scorer", "component") {
    Component(n112, "RiskScorer", "class", "Illustrative implementation\n+score(payment): RiskScore")
  }
}
rectangle "Rules Engine — Code" as panel_18 {
  Boundary(n114, "Rules Engine", "component") {
    Component(n115, "RuleSet", "class", "Illustrative implementation\n+evaluate(payment, score): Decision")
  }
}
