  Container(n62, "Fraud Scoring", "Python ML model", "Scores each payment for fraud risk before authorization")
  ContainerQueue(n63, "Payment Event Stream", "Event bus", "Ordered payment lifecycle events")
  Container_Boundary(n64, "Payment Orchestrator") {
    Component(n65, "Payment State Machine", "Java", "Owns payment state transitions and retries")
    Component(n66, "Acquirer Router", "Java", "Chooses the acquiring connection by card and region")
    Component(n67, "3DS Handler", "Java", "Runs 3-D Secure cardholder authentication")
  }
}
rectangle "Payments API — Component" as panel_6 {
  System_Ext(n69, "Merchant Webhook Endpoint", "Merchant back-end that calls the API and receives events")
  Container(n70, "Checkout Web SDK", "TypeScript in the shopper's browser", "Hosted payment fields embedded in merchant checkout pages")
