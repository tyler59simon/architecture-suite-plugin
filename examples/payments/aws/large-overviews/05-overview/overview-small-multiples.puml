@startuml
' Architecture Suite schema 2.0; PlantUML computes its own layout
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
rectangle "PayStream — Context" as panel_0 {
  System(n1, "PayStream", "Online payments platform: checkout, card processing, ledger and payouts")
  Person(n2, "Shopper", "Pays for orders at merchant checkouts")
  Person(n3, "Merchant", "Accepts payments and receives payouts")
  Person(n4, "Risk Analyst", "Reviews flagged payments and fraud rules")
  Person(n5, "Finance Operations", "Reconciles settlements and payouts")
  System_Ext(n6, "Acquirer Processor", "Card authorization, capture and settlement")
  System_Ext(n7, "3-D Secure Directory Server", "Card network cardholder authentication")
  System_Ext(n8, "Bank Payout Rail", "Bank transfers for merchant payouts")
  System_Ext(n9, "Merchant Webhook Endpoint", "Merchant back-end that calls the API and receives events")
}
rectangle "PayStream — Container" as panel_1 {
  Person(n11, "Shopper", "Pays for orders at merchant checkouts")
  Person(n12, "Merchant", "Accepts payments and receives payouts")
  Person(n13, "Risk Analyst", "Reviews flagged payments and fraud rules")
  Person(n14, "Finance Operations", "Reconciles settlements and payouts")
  System_Ext(n15, "Acquirer Processor", "Card authorization, capture and settlement")
  System_Ext(n16, "3-D Secure Directory Server", "Card network cardholder authentication")
  System_Ext(n17, "Bank Payout Rail", "Bank transfers for merchant payouts")
  System_Ext(n18, "Merchant Webhook Endpoint", "Merchant back-end that calls the API and receives events")
  System_Boundary(n19, "PayStream") {
    Container(n20, "Checkout Web SDK", "TypeScript in the shopper's browser", "Hosted payment fields embedded in merchant checkout pages")
    Container(n21, "Merchant Dashboard", "React single-page app", "Payments, refunds, disputes and payouts for merchants")
    Container(n22, "Payments API", "Go", "Public REST API for payment intents, captures and refunds")
    Container(n23, "Card Vault", "Rust", "Tokenizes card numbers inside the cardholder data environment")
    Container(n24, "Payment Orchestrator", "Java", "Drives each payment through authorization, capture and refund")
    Container(n25, "Fraud Scoring", "Python ML model", "Scores each payment for fraud risk before authorization")
    Container(n26, "Ledger Service", "Kotlin", "Double-entry ledger of balances, fees and payouts")
    Container(n27, "Webhook Dispatcher", "Node.js", "Signs and delivers payment events to merchants, with retries")
    Container(n28, "Settlement Worker", "Python batch jobs", "Reconciles acquirer settlement files and initiates payouts")
    ContainerDb(n29, "Payments Database", "PostgreSQL", "Payment intents, merchants and API keys")
    ContainerDb(n30, "Ledger Store", "Distributed SQL", "Strongly consistent journal and balance records")
    ContainerDb(n31, "Idempotency Cache", "Redis", "Short-lived idempotency keys and responses")
    ContainerQueue(n32, "Payment Event Stream", "Event bus", "Ordered payment lifecycle events")
    ContainerDb(n33, "Vault Key Store", "Managed KMS", "Key-encryption keys for the card vault")
    ContainerDb(n34, "Reporting Warehouse", "Columnar warehouse", "Reconciliation and finance analytics")
    ContainerDb(n35, "Settlement Archive", "Object storage", "Raw acquirer settlement files")
  }
}
rectangle "Card Vault — Component" as panel_2 {
  Container(n37, "Checkout Web SDK", "TypeScript in the shopper's browser", "Hosted payment fields embedded in merchant checkout pages")
  Container(n38, "Payment Orchestrator", "Java", "Drives each payment through authorization, capture and refund")
  ContainerDb(n39, "Vault Key Store", "Managed KMS", "Key-encryption keys for the card vault")
  Container_Boundary(n40, "Card Vault") {
    Component(n41, "Card Tokenizer", "Rust", "Swaps card numbers for single-purpose tokens")
    Component(n42, "Envelope Encryptor", "Rust", "Encrypts card data with per-record data keys")
  }
}
rectangle "Fraud Scoring — Component" as panel_3 {
  Person(n44, "Risk Analyst", "Reviews flagged payments and fraud rules")
  Container(n45, "Payment Orchestrator", "Java", "Drives each payment through authorization, capture and refund")
  Container_Boundary(n46, "Fraud Scoring") {
    Component(n47, "Risk Scorer", "Python", "Returns a risk score from the hosted model")
    Component(n48, "Rules Engine", "Python", "Applies merchant and platform block rules")
  }
}
rectangle "Ledger Service — Component" as panel_4 {
  Container(n50, "Settlement Worker", "Python batch jobs", "Reconciles acquirer settlement files and initiates payouts")
  ContainerDb(n51, "Ledger Store", "Distributed SQL", "Strongly consistent journal and balance records")
  ContainerQueue(n52, "Payment Event Stream", "Event bus", "Ordered payment lifecycle events")
  ContainerDb(n53, "Reporting Warehouse", "Columnar warehouse", "Reconciliation and finance analytics")
  Container_Boundary(n54, "Ledger Service") {
    Component(n55, "Journal Writer", "Kotlin", "Posts balanced journal entries for money movements")
    Component(n56, "Balance Calculator", "Kotlin", "Computes available and pending merchant balances")
  }
}
rectangle "Payment Orchestrator — Component" as panel_5 {
  System_Ext(n58, "Acquirer Processor", "Card authorization, capture and settlement")
  System_Ext(n59, "3-D Secure Directory Server", "Card network cardholder authentication")
  Container(n60, "Payments API", "Go", "Public REST API for payment intents, captures and refunds")
