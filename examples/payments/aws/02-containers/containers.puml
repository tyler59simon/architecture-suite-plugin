@startuml
' Architecture Suite schema 2.0; PlantUML computes its own layout
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
Person(n0, "Shopper", "Pays for orders at merchant checkouts")
Person(n1, "Merchant", "Accepts payments and receives payouts")
Person(n2, "Risk Analyst", "Reviews flagged payments and fraud rules")
Person(n3, "Finance Operations", "Reconciles settlements and payouts")
System_Ext(n4, "Acquirer Processor", "Card authorization, capture and settlement")
System_Ext(n5, "3-D Secure Directory Server", "Card network cardholder authentication")
System_Ext(n6, "Bank Payout Rail", "Bank transfers for merchant payouts")
System_Ext(n7, "Merchant Webhook Endpoint", "Merchant back-end that calls the API and receives events")
System_Boundary(n8, "PayStream") {
  Container(n9, "Checkout Web SDK", "TypeScript in the shopper's browser", "Hosted payment fields embedded in merchant checkout pages")
  Container(n10, "Merchant Dashboard", "React single-page app", "Payments, refunds, disputes and payouts for merchants")
  Container(n11, "Payments API", "Go", "Public REST API for payment intents, captures and refunds")
  Container(n12, "Card Vault", "Rust", "Tokenizes card numbers inside the cardholder data environment")
  Container(n13, "Payment Orchestrator", "Java", "Drives each payment through authorization, capture and refund")
  Container(n14, "Fraud Scoring", "Python ML model", "Scores each payment for fraud risk before authorization")
  Container(n15, "Ledger Service", "Kotlin", "Double-entry ledger of balances, fees and payouts")
  Container(n16, "Webhook Dispatcher", "Node.js", "Signs and delivers payment events to merchants, with retries")
  Container(n17, "Settlement Worker", "Python batch jobs", "Reconciles acquirer settlement files and initiates payouts")
  ContainerDb(n18, "Payments Database", "PostgreSQL", "Payment intents, merchants and API keys")
  ContainerDb(n19, "Ledger Store", "Distributed SQL", "Strongly consistent journal and balance records")
  ContainerDb(n20, "Idempotency Cache", "Redis", "Short-lived idempotency keys and responses")
  ContainerQueue(n21, "Payment Event Stream", "Event bus", "Ordered payment lifecycle events")
  ContainerDb(n22, "Vault Key Store", "Managed KMS", "Key-encryption keys for the card vault")
  ContainerDb(n23, "Reporting Warehouse", "Columnar warehouse", "Reconciliation and finance analytics")
  ContainerDb(n24, "Settlement Archive", "Object storage", "Raw acquirer settlement files")
}
Rel(n0, n9, "Enters card details at checkout [HTTPS]")
Rel(n13, n14, "Requests a fraud score [gRPC]")
Rel(n2, n14, "Reviews flagged payments and tunes rules [HTTPS]")
Rel(n13, n5, "Authenticates the cardholder [EMV 3DS over HTTPS]")
Rel(n13, n12, "Detokenizes the card for the network request [mTLS]")
Rel(n13, n4, "Authorizes, captures and refunds [ISO 8583 over TLS]")
Rel(n12, n22, "Wraps and unwraps data keys [KMS API]")
Rel(n13, n21, "Publishes payment lifecycle events [events]")
Rel(n21, n15, "Delivers captured, refunded and fee events [events]")
Rel(n15, n19, "Posts double-entry journal entries [SQL]")
Rel(n15, n23, "Streams journal entries [batch export]")
Rel(n9, n12, "Submits card data for a token [HTTPS]")
Rel(n21, n16, "Delivers merchant-facing events [events]")
Rel(n16, n7, "Delivers signed webhooks [HTTPS]")
Rel(n17, n4, "Downloads settlement files [SFTP]")
Rel(n17, n24, "Archives settlement files [object API]")
Rel(n17, n15, "Reconciles merchant balances [gRPC]")
Rel(n17, n6, "Initiates merchant payouts [ISO 20022]")
Rel(n3, n23, "Runs reconciliation and payout reports [SQL]")
Rel(n9, n11, "Confirms the payment with the card token [HTTPS]")
Rel(n1, n10, "Reviews payments, refunds and payouts [HTTPS]")
Rel(n10, n11, "Lists payments and issues refunds [HTTPS]")
Rel(n7, n11, "Calls the API server-side with a secret key [HTTPS]")
Rel(n11, n18, "Looks up API keys; Persists payment intents [SQL]")
Rel(n11, n20, "Stores request keys and responses [Redis]")
Rel(n11, n13, "Starts authorization [gRPC]")
SHOW_LEGEND()
@enduml
