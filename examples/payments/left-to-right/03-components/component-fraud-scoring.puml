@startuml
' Architecture Suite schema 2.0; PlantUML computes its own layout
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
Person(n0, "Risk Analyst", "Reviews flagged payments and fraud rules")
Container(n1, "Payment Orchestrator", "Java", "Drives each payment through authorization, capture and refund")
Container_Boundary(n2, "Fraud Scoring") {
  Component(n3, "Risk Scorer", "Python", "Returns a risk score from the hosted model")
  Component(n4, "Rules Engine", "Python", "Applies merchant and platform block rules")
}
Rel(n1, n3, "Requests a fraud score [gRPC]")
Rel(n3, n4, "Applies block and review rules [in-process]")
Rel(n0, n4, "Reviews flagged payments and tunes rules [HTTPS]")
SHOW_LEGEND()
@enduml
