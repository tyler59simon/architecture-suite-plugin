@startuml
' Architecture Suite schema 2.0; PlantUML computes its own layout
!include <C4/C4_Component>
LAYOUT_LEFT_RIGHT()
Boundary(n0, "Payment State Machine", "component") {
  Component(n1, "PaymentStateMachine", "class", "Illustrative implementation\n+authorize(payment): Authorization\n+capture(payment, amount): Capture\n+refund(payment, amount): Refund")
  Component(n2, "PaymentState", "interface", "Illustrative implementation\n+next(event): PaymentState")
}
Rel(n1, n2, "Delegates each transition to the current state [in-process]")
SHOW_LEGEND()
@enduml
