%% Architecture Suite schema 2.0; portable layout is independent of ELK
flowchart LR
  n0["Developer#10;«person»#10;Installs the system, approves governance#10;plans, reads notes"]
  n1["Agent Harness#10;«software_system»#10;Codex, Claude Code, Factory or Copilot;#10;fires lifecycle hooks and runs the agent#10;that decides what to capture"]
  n2["Obsidian#10;«software_system»#10;Optional vault receiving a staged overlay#10;of notes, canvas and dashboards"]
  n3["Headless Browser#10;«software_system»#10;Renders approved corporate PDFs in an#10;isolated temporary profile"]
  subgraph n4["Agentic Living Memory"]
    n5["Hook Adapters#10;«container»#10;Python#10;Per-harness lifecycle hooks that inject#10;protocol and retrieved context at session#10;start and request one capture review at#10;stop"]
    n6["Memory CLI#10;«container»#10;Python#10;Single compact script interface (living_#10;memory.py) used by hooks and by the#10;agent for every action"]
    n7["Canonical Note Store#10;«container»#10;Markdown files#10;Markdown notes with JSON-compatible#10;frontmatter, bindings, taxonomy and#10;operation journals"]
    n8["Derived Index#10;«container»#10;SQLite FTS5#10;Disposable SQLite FTS5 databases and#10;catalogs, rebuildable from the note store"]
  end
  n0 -->|"Runs one-time setup and wizard"| n5
  n1 -->|"Fires SessionStart, UserPromptSubmit and Stop events#10;#91;Hook payload JSON#93;"| n5
  n5 -->|"Requests retrieval and records turns"| n6
  n1 -->|"Agent invokes capture and governance scripts #91;CLI#93;"| n6
  n6 -->|"Atomic locked writes with revision checks; Journaled#10;mutations and recovery"| n7
  n6 -->|"Queries and rebuilds the index #91;SQLite#93;"| n8
  n8 -->|"Rebuilt from notes when dirty"| n7
  n6 -->|"Publishes staged overlay"| n2
  n6 -->|"Renders approved PDF"| n3
  notation_key["Name · «type» · technology · responsibility#10;Frame = scope; arrow = directed dependency"]
